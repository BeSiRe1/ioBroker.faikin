      "size": 3,
      "sm": 12
    },
    "username": {
      "newLine": true,
      "type": "text",
      "label": "MQTT-Benutzername (optional)",
      "sm": 6,
      "md": 6,
      "lg": 6
    },
    "password": {
      "type": "password",
      "label": "MQTT-Passwort (optional)",
      "sm": 6,
      "md": 6,
      "lg": 6
    },
    "_topicsHeader": {
      "newLine": true,
      "type": "header",
      "text": "Geräte und MQTT-Themen",
      "size": 3,
      "sm": 12
    },
    "hostname": {
      "newLine": true,
      "type": "text",
      "label": "Standard-Hostname für allgemeine MQTT-Themen",
